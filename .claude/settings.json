{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm exec playwright*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git checkout -b ai/*)",
      "Bash(git switch -c ai/*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push origin ai/*)",
      "Bash(git push -u origin ai/*)",
      "Bash(gh issue view*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr create*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr checkout*)",
      "Bash(gh pr list*)"
    ],
    "ask": [
      "Bash(pnpm add*)",
      "Bash(pnpm remove*)",
      "Bash(npx medusa db:*)",
      "Bash(pnpm medusa db:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./.env*)",
      "Edit(./**/.env*)",
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge*)",
      "Bash(gh release create*)",
      "Bash(git tag*)",
      "Bash(rm -rf*)",
      "Bash(*deploy*production*)",
      "Bash(*DATABASE_URL*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/guard.sh" }
        ]
      }
    ]
  }
}
